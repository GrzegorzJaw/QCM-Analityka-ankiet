rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Global helpers
    function isSignedIn() { return request.auth != null; }
    // Check if user is in 'admins' collection
    function isAdmin() { return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }

    // Surveys collection
    match /ankiety/{surveyId} {
      // Allow list and get for everyone (Guest mode)
      allow read: if true; 
      
      // Allow create, update, delete (Secure this in production with Auth)
      allow create, update, delete: if true;
    }

    // Admins collection - only for the system to check roles
    match /admins/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow write: if false;
    }
  }
}
